# === Database ===
DB_HOST=localhost
# XAMPP default is 3306. Change this only if your MySQL runs on a custom port.
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=shop_charge_db
# DB_ROOT_PASS is only used by docker-compose to initialize the MySQL container.
# For non-Docker deployments, it can be left empty.
DB_ROOT_PASS=

# === Backup Configuration ===
# Optional. If not set, defaults are used (see scripts/backup-db.js).
# MYSQLDUMP_PATH: Full path to the mysqldump binary.
#   - On Linux with system MySQL: leave empty (uses "mysqldump" from PATH)
#   - On Windows with XAMPP: C:\xampp\mysql\bin\mysqldump.exe
MYSQLDUMP_PATH=
# MYSQL_PATH: Full path to the mysql binary (used by restore-db.js).
#   - On Linux: leave empty (uses "mysql" from PATH)
#   - On Windows with XAMPP: C:\xampp\mysql\bin\mysql.exe
MYSQL_PATH=
# BACKUP_DIR: Directory where backup files are stored.
#   - Default: ./backups (relative to project root)
BACKUP_DIR=
# BACKUP_RETENTION_DAYS: Number of days to keep old backups before deletion.
#   - Default: 30
BACKUP_RETENTION_DAYS=30
# DB_ROOT_PASS is only used by docker-compose to initialize the MySQL container.
# For non-Docker deployments, it can be left empty.
DB_ROOT_PASS=

# === Server ===
PORT=3514
NODE_ENV=development

# === Security ===
JWT_SECRET=change_me_to_a_random_64_char_string
ADMIN_USER=admin
ADMIN_PASS=change_me_to_a_strong_password

# === Trust Proxy ===
TRUST_PROXY=1

# === Seed ===
# SEED_DEMO_DATA: "true" seeds demo shops/charges/receipts (development).
#                 Set to "false" for a dry production install (admin + settings only).
# SEED_DEMO_DATA=true

# === SMS Configuration ===
# SMS_PROVIDER: "mock" (dev/test — no real SMS, code logged to combined.log)
#               "kavenegar" (production — real SMS via Kavenegar API)
SMS_PROVIDER=mock
# SMS_API_KEY: Kavenegar API key. Leave empty in mock mode.
SMS_API_KEY=
# SMS_SENDER: Kavenegar sender line number. Leave empty in mock mode.
# Example: 10008663 (this is Kavenegar's shared OTP line)
SMS_SENDER=