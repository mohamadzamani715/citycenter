<!DOCTYPE html>
<html lang="fa">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="csrf-token" content="<%= csrfToken %>">
  <title>ورود به سیستم</title>
  <link href="https://cdn.jsdelivr.net/gh/rastikerdar/vazirmatn@v33.003/Vazirmatn-font-face.css" rel="stylesheet" type="text/css" />
  <link rel="stylesheet" href="/css/style.css">
  <link rel="icon" href="data:,">
</head>
<body>
  <div class="container">
    <div class="header">
      <h1>سیستم شارژ مغازه‌ها</h1>
      <button id="toggleTheme" class="btn-theme toggle-theme-btn" title="تغییر تم">
        <span class="theme-icon">🌙</span>
      </button>
    </div>

    <div class="tabs">
      <button class="tab-btn active" data-tab="admin">ورود مدیر</button>
      <button class="tab-btn" data-tab="shop">ورود و عضویت مغازه‌دار</button>
    </div>

    <div id="admin" class="tab-content active">
      <h2>ورود مدیر</h2>
      <form id="adminLoginForm">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="form-group">
          <label for="adminUsername">نام کاربری</label>
          <input type="text" id="adminUsername" name="username" required>
        </div>
        <div class="form-group">
          <label for="adminPassword">رمز عبور</label>
            <input type="password" id="adminPassword" name="password" autocomplete="current-password" required>
        </div>
        <button type="submit" class="btn btn-primary">ورود</button>
      </form>
    </div>

    <div id="shop" class="tab-content">
      <div class="sub-tabs">
        <button class="sub-tab-btn active" data-subtab="login">ورود</button>
        <button class="sub-tab-btn" data-subtab="register">عضویت</button>
      </div>

      <div id="login" class="sub-tab-content active">
        <h2>ورود مغازه‌دار</h2>
        <form id="shopLoginForm">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="form-group">
            <label for="shopNationalCode">کد ملی</label>
            <input type="text" id="shopNationalCode" name="national_code" required>
          </div>
          <div class="form-group">
            <label for="shopPassword">رمز عبور</label>
            <input type="password" id="shopPassword" name="password" autocomplete="current-password" required>
          </div>
          <div class="forgot-password">
            <button type="button" id="forgotPasswordBtn">فراموشی رمز عبور</button>
          </div>
          <button type="submit" class="btn btn-primary">ورود</button>
        </form>
      </div>

      <div id="register" class="sub-tab-content">
        <h2>عضویت مغازه‌دار</h2>
        <form id="shopRegisterForm">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="form-group">
            <label for="regFirstName">نام</label>
            <input type="text" id="regFirstName" name="first_name" required>
          </div>
          <div class="form-group">
            <label for="regLastName">نام خانوادگی</label>
            <input type="text" id="regLastName" name="last_name" required>
          </div>
          <div class="form-group">
            <label for="regNationalCode">کد ملی</label>
            <input type="text" id="regNationalCode" name="national_code" required>
          </div>
          <div class="form-group">
            <label for="regPlaque">پلاک مغازه</label>
            <input type="text" id="regPlaque" name="plaque" required>
          </div>
          <div class="form-group">
            <label for="regPhone">شماره تماس</label>
            <input type="text" id="regPhone" name="phone" required>
          </div>
          <div class="form-group">
            <label for="regPassword">رمز عبور</label>
            <input type="password" id="regPassword" name="password" autocomplete="new-password" required>
          </div>
          <div class="form-group">
            <label for="regConfirmPassword">تکرار رمز عبور</label>
            <input type="password" id="regConfirmPassword" name="confirm_password" autocomplete="new-password" required>
          </div>
          <button type="submit" class="btn btn-primary">ثبت‌نام</button>
        </form>
      </div>
    </div>
  </div>

  <!-- Forgot Password Modal -->
  <div id="forgotPasswordModal" class="modal">
    <div class="modal-content">
      <span class="close">&times;</span>
      <h2>فراموشی رمز عبور</h2>
      
      <div id="forgotStep1">
        <form id="forgotStep1Form">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="form-group">
            <label for="forgotPhone">شماره تماس</label>
            <input type="text" id="forgotPhone" name="phone" required>
          </div>
          <button type="submit" class="btn btn-primary">ارسال کد</button>
        </form>
      </div>

      <div id="forgotStep2" class="forgot-step-2-hidden">
        <form id="forgotStep2Form">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <!-- phone is captured in step 1 and copied here so step 2 can send it -->
          <input type="hidden" id="forgotPhoneHidden" name="phone" value="">
          <div class="form-group">
            <label for="forgotCode">کد تایید</label>
            <input type="text" id="forgotCode" name="code" required>
          </div>
          <div class="form-group">
            <label for="forgotNewPassword">رمز عبور جدید</label>
            <input type="password" id="forgotNewPassword" name="newPassword" autocomplete="new-password" required>
          </div>
          <div class="form-group">
            <label for="forgotConfirmNewPassword">تکرار رمز عبور جدید</label>
            <input type="password" id="forgotConfirmNewPassword" name="confirmPassword" autocomplete="new-password" required>
          </div>
          <button type="submit" class="btn btn-primary">تغییر رمز</button>
        </form>
      </div>
    </div>
  </div>

  <script src="/js/main.js" nonce="<%= cspNonce %>"></script>
</body>
</html>
